<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DevamsizlikHakkim.YeniDersPage"
             Title="Yeni Ders Ekle"
             BackgroundColor="#F8BBD0"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16,10,16,24">

            <!-- Üst Navigasyon Çubuğu -->
            <Grid HeightRequest="44" Margin="0,5,0,5">
                <!-- Sayfa Başlığı (Tam Ortalanmış) -->
                <Label Text="Yeni Ders Ekle"
                       TextColor="#910623"
                       FontSize="22"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />

                <!-- Geri Dönüş Butonu (Sola Hizalı) -->
                <Border StrokeShape="RoundRectangle 18"
                        BackgroundColor="White"
                        StrokeThickness="1"
                        Stroke="#F9CFDF"
                        WidthRequest="42"
                        HeightRequest="42"
                        HorizontalOptions="Start"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnGeriClicked" />
                    </Border.GestureRecognizers>
                    <Label Text="←"
                           TextColor="#910623"
                           FontSize="22"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
            </Grid>

            <!-- Form Kartı -->
            <Border BackgroundColor="White"
                    StrokeThickness="1"
                    Stroke="#F9CFDF"
                    StrokeShape="RoundRectangle 22"
                    Padding="20"
                    Margin="0,5,0,10">

                <VerticalStackLayout Spacing="18">

                    <!-- Ders Bilgileri Başlık Alanı -->
                    <VerticalStackLayout Spacing="6">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Image Source="kitap.png"
                                   WidthRequest="22"
                                   HeightRequest="22"
                                   VerticalOptions="Center" />
                            <Label Text="Ders Bilgileri"
                                   TextColor="#910623"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Label Text="Hesaplama yapmak için aşağıdaki bilgileri giriniz."
                               TextColor="#A35A7A"
                               FontSize="13" />

                        <BoxView HeightRequest="1"
                                 Color="#FCE2EC"
                                 Margin="0,6,0,0" />
                    </VerticalStackLayout>

                    <!-- Ders Adı -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Ders Adı"
                               TextColor="#910623"
                               FontAttributes="Bold"
                               FontSize="14" />
                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="#F9CFDF"
                                StrokeThickness="1"
                                BackgroundColor="#FFF5F8"
                                Padding="12,0">
                            <Entry x:Name="DersAdiEntry"
                                   Placeholder="Örn: Mobil Programlama"
                                   PlaceholderColor="#C48E9F"
                                   TextColor="#910623"
                                   FontSize="14"
                                   HeightRequest="46" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Toplam Hafta -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Dersin Toplam Haftası"
                               TextColor="#910623"
                               FontAttributes="Bold"
                               FontSize="14" />
                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="#F9CFDF"
                                StrokeThickness="1"
                                BackgroundColor="#FFF5F8"
                                Padding="12,0">
                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <Entry x:Name="ToplamHaftaEntry"
                                       Grid.Column="0"
                                       Keyboard="Numeric"
                                       Placeholder="Örn: 14"
                                       PlaceholderColor="#C48E9F"
                                       TextColor="#910623"
                                       FontSize="14"
                                       HeightRequest="46" />
                                <Label Grid.Column="1"
                                       Text="hafta"
                                       TextColor="#A35A7A"
                                       FontSize="14"
                                       VerticalOptions="Center"
                                       Margin="0,0,4,0" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Haftalık Ders Saati -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Haftalık Ders Saati"
                               TextColor="#910623"
                               FontAttributes="Bold"
                               FontSize="14" />
                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="#F9CFDF"
                                StrokeThickness="1"
                                BackgroundColor="#FFF5F8"
                                Padding="12,6">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalOptions="Center">
                                <!-- Eksi Butonu -->
                                <Button Grid.Column="0"
                                        Text="-"
                                        TextColor="White"
                                        BackgroundColor="#EC4899"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        CornerRadius="10"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        Padding="0"
                                        Clicked="OnEksiClicked" />

                                <!-- Saat Değeri -->
                                <Label Grid.Column="1"
                                       x:Name="HaftalikSaatLabel"
                                       Text="3"
                                       TextColor="#910623"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />

                                <!-- Artı Butonu -->
                                <Button Grid.Column="2"
                                        Text="+"
                                        TextColor="White"
                                        BackgroundColor="#EC4899"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        CornerRadius="10"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        Padding="0"
                                        Clicked="OnArtiClicked" />

                                <!-- "saat" Yazısı -->
                                <Label Grid.Column="3"
                                       Text="saat"
                                       TextColor="#A35A7A"
                                       FontSize="14"
                                       VerticalOptions="Center"
                                       Margin="12,0,4,0" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Devamsızlık Sınırı (%) -->
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <Label Grid.Column="0"
                                   Text="Devamsızlık Sınırı (%)"
                                   TextColor="#910623"
                                   FontAttributes="Bold"
                                   FontSize="14" />
                            <Label Grid.Column="1"
                                   x:Name="DevamsizlikSiniriLabel"
                                   Text="%20"
                                   TextColor="#EC4899"
                                   FontAttributes="Bold"
                                   FontSize="16" />
                        </Grid>

                        <Slider x:Name="DevamsizlikSiniriSlider"
                                Minimum="0"
                                Maximum="50"
                                Value="20"
                                MinimumTrackColor="#EC4899"
                                MaximumTrackColor="#F9CFDF"
                                ThumbColor="#EC4899"
                                ValueChanged="OnSliderValueChanged" />

                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Label Grid.Column="0" Text="%0" TextColor="#A35A7A" FontSize="11" />
                            <Label Grid.Column="1" Text="%25" TextColor="#A35A7A" FontSize="11" HorizontalOptions="Center" />
                            <Label Grid.Column="2" Text="%50" TextColor="#A35A7A" FontSize="11" HorizontalOptions="End" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Yapılan Devamsızlık (saat) -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Yapılan Devamsızlık (saat)"
                               TextColor="#910623"
                               FontAttributes="Bold"
                               FontSize="14" />
                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="#F9CFDF"
                                StrokeThickness="1"
                                BackgroundColor="#FFF5F8"
                                Padding="12,0">
                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <Entry x:Name="YapilanDevamsizlikEntry"
                                       Grid.Column="0"
                                       Keyboard="Numeric"
                                       Placeholder="Örn: 2"
                                       PlaceholderColor="#C48E9F"
                                       TextColor="#910623"
                                       FontSize="14"
                                       HeightRequest="46" />
                                <Label Grid.Column="1"
                                       Text="saat"
                                       TextColor="#A35A7A"
                                       FontSize="14"
                                       VerticalOptions="Center"
                                       Margin="0,0,4,0" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Dersi Kaydet Butonu -->
                    <Button Text="Dersi Kaydet"
                            TextColor="White"
                            BackgroundColor="#EC4899"
                            FontAttributes="Bold"
                            FontSize="16"
                            CornerRadius="16"
                            HeightRequest="50"
                            Margin="0,10,0,0"
                            Clicked="OnDersiKaydetClicked" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
